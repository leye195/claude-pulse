{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "electron/**/*",
    "src/shared/types/settings.ts",
    "src/shared/types/stats.ts",
    "src/shared/types/history.ts",
    "src/shared/types/tab.ts",
    "src/shared/utils/sessionAlertLogic.ts",
    "vite.config.ts"
  ]
}
